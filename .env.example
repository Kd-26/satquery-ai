# SatQuery AI local configuration
# Copy this file to .env at the repository root. Never commit .env.

APP_NAME=SatQuery AI
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/satquery
CORS_ORIGINS=["http://localhost:3000"]

# OpenAI: intent classification, planning/replanning, and semantic verification
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MAX_TOKENS_PER_RUN=4096
OPENAI_VERIFIER_ENABLED=true

# Modal Qwen VLM: visual observation/comparison and evidence-grounded synthesis
# Use an OpenAI-compatible base URL ending in /v1, or the complete
# .../chat/completions URL.
MODAL_VLM_API_BASE=https://coderkd26--satquery-vlm-l40s-satqueryl40sserver.us-east.modal.direct/v1
MODAL_VLM_MODEL_ID=satquery-vlm
MODAL_REQUEST_TIMEOUT_S=600

# Modal authentication — choose ONE approach:
# A) separate Modal proxy-token headers (recommended for protected Web Functions)
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# B) a combined wk-....ws-... proxy token or a custom endpoint bearer token
MODAL_VLM_API_KEY=

# Adapter IDs must match the adapters loaded by the Modal endpoint.
LORA_GENERAL=lora_general_v1
LORA_OPTICAL=lora_optical_v1
LORA_TEMPORAL=lora_temporal_v1
LORA_CROSSMODAL=lora_crossmodal_v1
LORA_GROUNDING=lora_grounding_v1

# Dedicated scientific segmentation service (not an LLM/VLM-generated mask)
SEGMENTATION_ENDPOINT=http://localhost:8001
QUALITY_MIN_VALID_FRACTION=0.2
SAR_LEE_FILTER_SIZE=5

# Optional legacy providers. Role-bound controllers do not use these for
# OpenAI planning or Modal visual/synthesis stages.
VLM_PROVIDER_ORDER=openai,modal,nvidia,local
NIM_API_KEY=
LOCAL_VLM_API_BASE=
