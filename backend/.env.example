# SatQuery AI — Environment Variables
# Copy this file to .env and fill in your values.

APP_NAME=SatQuery AI

# REQUIRED — PostgreSQL with PostGIS. asyncpg driver.
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/satquery

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=["http://localhost:3000"]

# ── Agent Brain (OpenAI) ─────────────────────────────────────────────────────
AGENT_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_MAX_COST_PER_RUN_USD=0.05
OPENAI_MAX_TOKENS_PER_RUN=8192

# ── Visual Specialist (Qwen 9B) ───────────────────────────────────────────────
VISUAL_PROVIDER=qwen_local
VISUAL_MODEL_ENDPOINT=http://localhost:8000/v1
QWEN_BASE_MODEL_PATH=Qwen/Qwen2.5-VL-7B-Instruct

# ── Segmentation Provider ────────────────────────────────────────────────────
SEGMENTATION_PROVIDER=local_service
SEGMENTATION_ENDPOINT=http://localhost:8001/v1

# ── Legacy NVIDIA NIM (Kept for optional fallback if configured) ─────────────
NIM_API_BASE=https://integrate.api.nvidia.com/v1
NIM_API_KEY=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
VLM_MODEL_ID=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ── LoRA fine-tuned adapters (leave blank until model is trained) ─────────────
LORA_OPTICAL=
LORA_SAR=
LORA_TEMPORAL=
LORA_CROSSMODAL=
LORA_GROUNDING=