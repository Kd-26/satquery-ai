# SatQuery AI — Environment Variables
# Legacy location. Prefer copying the repository-root .env.example to ../.env.

APP_NAME=SatQuery AI

# REQUIRED — PostgreSQL with PostGIS. asyncpg driver.
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/satquery

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=["http://localhost:3000"]

# ── Provider Routing Strategy ────────────────────────────────────────────────
# Ordered priority list of LLM/VLM providers to attempt.
VLM_PROVIDER_ORDER=openai,modal,nvidia,local
VLM_REQUEST_TOKEN_LIMIT=8192

# ── Main Agent Brain (OpenAI) ────────────────────────────────────────────────
# Drives planning (DAG tool calling), intent classification, and verifier.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MAX_TOKENS_PER_RUN=4096
OPENAI_VERIFIER_ENABLED=true

# ── Fine-Tuned VLM Specialist (Modal / Hosted Endpoint) ──────────────────────
# Drives satellite visual interpretation, multi-LoRA land cover scoring, and scientific explanations.
MODAL_VLM_API_BASE=https://coderkd26--satquery-vlm-l40s-satqueryl40sserver.us-east.modal.direct/v1
MODAL_VLM_API_KEY=
MODAL_VLM_MODEL_ID=satquery-vlm
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_REQUEST_TIMEOUT_S=600
VISUAL_MODEL_ENDPOINT=
QWEN_BASE_MODEL_PATH=Qwen/Qwen2-VL-7B-Instruct
LORA_GENERAL=lora_general_v1
LORA_OPTICAL=lora_optical_v1
LORA_TEMPORAL=lora_temporal_v1
LORA_CROSSMODAL=lora_crossmodal_v1
LORA_GROUNDING=lora_grounding_v1

# ── NVIDIA NIM API (VLM Fallback) ────────────────────────────────────────────
NIM_API_BASE=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
VLM_MODEL_ID=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
VLM_MAX_TOKENS=8192
VLM_REASONING_BUDGET=4096
VLM_TEMPERATURE=0.3
VLM_TOP_P=0.95
VLM_LORA_ADAPTER=

# ── Local / Microservices ────────────────────────────────────────────────────
LOCAL_VLM_API_BASE=
LOCAL_VLM_MODEL_ID=local-vlm
SEGMENTATION_ENDPOINT=http://localhost:8001
QUALITY_MIN_VALID_FRACTION=0.2
SAR_LEE_FILTER_SIZE=5
