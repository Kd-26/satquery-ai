# SatQuery AI — Environment Variables
# Copy this file to .env and fill in your values.

APP_NAME=SatQuery AI

# REQUIRED — PostgreSQL with PostGIS. asyncpg driver.
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/satquery

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=["http://localhost:3000"]

# ── NVIDIA NIM API (VLM) ─────────────────────────────────────────────────────
# Current model: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Supports: reasoning, vision, tool/function calling
NIM_API_BASE=https://integrate.api.nvidia.com/v1
NIM_API_KEY=replace-with-your-nvidia-api-key
VLM_MODEL_ID=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
VLM_MAX_TOKENS=8192
VLM_REASONING_BUDGET=4096
VLM_TEMPERATURE=0.3
VLM_TOP_P=0.95

# ── LoRA fine-tuned adapter (leave blank until model is trained) ──────────────
# When ready:
#   1. Set VLM_MODEL_ID to your fine-tuned model endpoint
#   2. Set VLM_LORA_ADAPTER to your adapter id
#   3. Uncomment the single marked line in backend/services/vlm_service.py
#   4. Update backend/registry/adapters/*.yaml with real endpoint + version
VLM_LORA_ADAPTER=
VLM_PROVIDER_ORDER=nvidia,local
VLM_REQUEST_TOKEN_LIMIT=8192
LOCAL_VLM_API_BASE=
LOCAL_VLM_MODEL_ID=local-vlm
QUALITY_MIN_VALID_FRACTION=0.2
SAR_LEE_FILTER_SIZE=5
